---
import Site from "../layouts/Site.astro";
import { paginaInterna } from "../lib/chiusura";
import {
  categorieOccupate,
  categoriaPrincipale,
  contaPerCategoria,
  idsCategorie,
  projectHref,
  tuttiIProgetti,
  withBase,
} from "../lib/archivio";

const chiuso = paginaInterna(Astro);
if (chiuso) return chiuso;

const [progetti, categorie] = await Promise.all([tuttiIProgetti(), categorieOccupate()]);
const cards = await Promise.all(
  progetti.map(async (p) => {
    const principale = await categoriaPrincipale(p);
    return { p, principale };
  }),
);
---

<Site
  title="Works — STUDIO MONO"
  description="Tutti i progetti di STUDIO MONO: residenze, architetture culturali e spazi pubblici."
  current="works"
>
  <main>
    <section class="page-hero">
      <p class="hero-meta mono">Archivio completo — 2009 → oggi</p>
      <h1 class="page-title">Opere <em>e</em> progetti.</h1>
    </section>

    <nav class="filters mono" id="filters" aria-label="Filtra per categoria">
      <button type="button" data-filter="ALL" class="active">
        All <span>({progetti.length})</span>
      </button>
      {
        categorie.map((cat) => (
          <button type="button" data-filter={cat.id}>
            {cat.data.label} <span>({contaPerCategoria(progetti, cat.id)})</span>
          </button>
        ))
      }
    </nav>

    <section class="works-grid" id="worksGrid">
      {
        cards.map(({ p, principale }) => (
          <a class="work-card" href={projectHref(p.id)} data-cats={idsCategorie(p).join(" ")}>
            <img class="work-img" src={withBase(p.data.foto)} alt={p.data.titolo} />
            <div class="card-meta">
              <span class="mono">{p.data.titolo}</span>
              <span class="mono">{principale?.data.label} · {p.data.anno}</span>
            </div>
          </a>
        ))
      }
    </section>
  </main>
  <script src="../scripts/works.ts"></script>
</Site>
