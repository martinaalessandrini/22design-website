---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import {
  categoriaPrincipale,
  fallbackIdea,
  fallbackIntro,
  fallbackTecnica,
  projectPic,
  titleHtml,
  withBase,
  type Progetto,
} from "../../lib/archivio";

export async function getStaticPaths() {
  const progetti = await getCollection("progetti");
  return progetti.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Progetto;
}

const { project } = Astro.props;
const principale = await categoriaPrincipale(project);
const label = principale?.data.label ?? "";
const lastWordItalic = titleHtml(project.data.titolo);
const intro = project.data.intro ?? fallbackIntro(project.data.titolo, label);
---

<Site
  title={`${project.data.titolo} — 22DESIGN`}
  description={`${project.data.titolo}: ${label} progettato da 22DESIGN, ${project.data.anno}.`}
  current="progetti"
>
  <main class="detail">
    <section class="detail-head">
      <p class="hero-meta mono">{label} — {project.data.anno}</p>
      <h1 class="page-title" set:html={lastWordItalic} />
      <p class="detail-intro">{intro}</p>
    </section>

    <figure class="ph detail-hero" data-reveal style={`background-image: url('${projectPic(project.data.foto, "01")}')`}></figure>

    <section class="detail-meta mono" data-reveal>
      <div><span>Committente</span><b>{project.data.committente ?? "—"}</b></div>
      <div><span>Luogo</span><b>{project.data.luogo ?? "—"}</b></div>
      <div><span>Anno</span><b>{project.data.anno}</b></div>
      <div><span>Superficie</span><b>{project.data.superficie ?? "—"}</b></div>
      <div><span>Stato</span><b>Completato</b></div>
    </section>

    <section class="detail-body" data-reveal>
      <div>
        <h3 class="mono">L'idea</h3>
        <p>{project.data.idea ?? fallbackIdea()}</p>
      </div>
      <figure class="ph detail-idea" aria-label="Immagine del progetto" data-reveal style={`background-image: url('${projectPic(project.data.foto, "02")}')`}></figure>
      <div>
        <h3 class="mono">Tecnica</h3>
        <p>{project.data.tecnica ?? fallbackTecnica()}</p>
      </div>
      <figure class="ph detail-tecnica" aria-label="Dettaglio tecnico" data-reveal style={`background-image: url('${projectPic(project.data.foto, "03")}')`}></figure>
    </section>

    <section class="detail-pager">
      <a href={withBase("works")} class="btn">← Tutti i progetti</a>
      <a href={withBase("contatti")} class="btn btn-dark">Raccontaci il tuo →</a>
    </section>
  </main>
</Site>
