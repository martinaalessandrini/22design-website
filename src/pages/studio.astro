---
import Site from "../layouts/Site.astro";
import { categorieOccupate } from "../lib/archivio";

const categorie = await categorieOccupate();
---

<Site
  title="Studio — STUDIO MONO"
  description="Lo studio: idee, metodo, persone. STUDIO MONO — architettura contemporanea da Milano."
  current="studio"
>
  <main>
    <section class="page-hero">
      <p class="hero-meta mono">Dal 2015 a Milano</p>
      <h1 class="page-title">Uno studio <em>piccolo</em>,<br>un'idea <em>grande</em>.</h1>
    </section>

    <section class="about-grid" data-reveal>
      <p class="about-text">STUDIO MONO nasce nel 2017 dall'incontro di due architetti con un'ossessione comune: ridurre fino all'essenziale. Lavoriamo su residenze, interior e allestimenti, spazi pubblici e concorsi. Ci piace il cantiere: il progetto non finisce sullo schermo, ma nel modo in cui il sole colpisce un muro alle cinque di sera.</p>

      <div class="services">
        {
          categorie.map((cat, i) => (
            <div class="service mono">
              <span>{String(i + 1).padStart(2, "0")}</span>
              {cat.data.label}
            </div>
          ))
        }
      </div>
    </section>

    <section class="values" data-reveal>
      <h2 class="mono">(03) — Come lavoriamo</h2>
      <div class="values-grid">
        <article><h3>01 / Essenziale</h3><p>Ogni elemento in più è un elemento in meno per chi abita lo spazio.</p></article>
        <article><h3>02 / Radicato</h3><p>La prima mossa non è disegnare, è leggere il luogo e il suo clima.</p></article>
        <article><h3>03 / Costruito</h3><p>Seguiamo la materia dal progetto al cantiere, fino alla posa del battiscopa.</p></article>
      </div>
    </section>

    <section class="team" data-reveal>
      <h2 class="mono">(04) — Persone</h2>
      <div class="team-grid">
        <div class="team-card">
          <span class="ph team team-1"></span>
          <h3>Martina Alessandrini</h3>
          <p class="mono">Fondatrice · Architetto</p>
        </div>
        <div class="team-card">
          <span class="ph team team-2"></span>
          <h3>Davide Fontana</h3>
          <p class="mono">Fondatore · Architetto</p>
        </div>
        <div class="team-card">
          <span class="ph team team-3"></span>
          <h3>Giulia Costa</h3>
          <p class="mono">Collaboratrice · Design &amp; Materiali</p>
        </div>
      </div>
    </section>

    <section class="cta" data-reveal>
      <a href="/works">
        <p class="mono">Curiosi di vedere cosa sappiamo fare?</p>
        <h2>I progetti.</h2>
      </a>
    </section>
  </main>
</Site>
