---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import "../styles/home.css";

const title = "STUDIO MONO — Sito in costruzione";
const description =
  "STUDIO MONO — studio di architettura contemporanea. Il nuovo sito è in costruzione.";
---

<Base title={title} description={description} home>
  <header class="home-header">
    <span class="logo">STUDIO&nbsp;MONO<sup>®</sup></span>
  </header>

  <div class="home-ui coming-soon-ui">
    <p class="mono home-kicker">Milano — nuovo sito in arrivo</p>
    <h1 class="home-title">Sito in <em>costruzione</em>.</h1>
    <p class="mono home-hint">Stiamo preparando l'archivio. Torna a trovarci a breve.</p>
  </div>
</Base>
