---
interface Props {
  current?: "progetti" | "works" | "studio" | "contatti";
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="logo">STUDIO&nbsp;MONO<sup>®</sup></a>
    <nav class="nav-links" id="navLinks">
      <a href="/" class={current === "progetti" ? "active" : undefined}>Progetti</a>
      <a href="/works" class={current === "works" ? "active" : undefined}>Works</a>
      <a href="/studio" class={current === "studio" ? "active" : undefined}>Studio</a>
      <a href="/contatti" class={current === "contatti" ? "active" : undefined}>Contatti</a>
    </nav>
    <button class="menu-toggle" id="menuToggle" aria-label="Apri menu"><span></span><span></span></button>
  </div>
</header>
