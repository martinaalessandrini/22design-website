---
import { withBase } from "../lib/archivio";

interface Props {
  current?: "progetti" | "studio" | "contatti";
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={withBase()} class="logo">22DESIGN<sup>®</sup></a>
    <nav class="nav-links" id="navLinks">
      <a href={withBase("works")} class={current === "progetti" ? "active" : undefined}>Progetti</a>
      <a href={withBase("studio")} class={current === "studio" ? "active" : undefined}>Studio</a>
      <a href={withBase("contatti")} class={current === "contatti" ? "active" : undefined}>Contatti</a>
    </nav>
    <button class="menu-toggle" id="menuToggle" aria-label="Apri menu"><span></span><span></span></button>
  </div>
</header>
